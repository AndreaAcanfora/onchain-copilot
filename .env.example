# Gemini (Google AI Studio, free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq (free tier), used when Gemini is out of quota: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: per-IP rate limit store. In-memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Etherscan V2 key, ABI fallback on chains still in the free tier.
ETHERSCAN_API_KEY=
